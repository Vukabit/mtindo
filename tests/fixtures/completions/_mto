_mto_completions() {
  local curcontext=$curcontext state state_descr line ret=1
  _arguments -C -s : \
    '(- *)'{-h,--help}'[Show this help and exit]' \
    '1: :->first' \
    '*:: :->rest' && ret=0
  case $state in
    (first)
      _alternative \
        'subcommands:subcommand:_mto_completions_subcommands' \
        'arguments:argument:(bash zsh fish powershell)' && ret=0
      ;;
    (rest)
      case $words[1] in
        (install)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--dir=[Use this folder instead of the shell'\''s own]:dir:_files -/' \
            '(-d --dry-run)'{-d,--dry-run}'[List the files that would change, without writing]' \
            '*: :(bash zsh fish powershell)' && ret=0
          ;;
        (uninstall)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--dir=[Use this folder instead of the shell'\''s own]:dir:_files -/' \
            '(-d --dry-run)'{-d,--dry-run}'[List the files that would change, without writing]' \
            '*: :(bash zsh fish powershell)' && ret=0
          ;;
        (status)
