#compdef mto
# mto VERSION completions for zsh, generated by `mto completions zsh`; do not edit.
# zsh loads it from a folder in $fpath, by compinit.

# --config's pairs: the settings, then after `=` the setting's values.
_mto_settings() {
  local -a keys
  keys=(
    array_width attr_fn_like_width binop_separator blank_lines_lower_bound
    blank_lines_upper_bound brace_style chain_width color combine_control_expr
    comment_width condense_wildcard_suffixes control_brace_style
    disable_all_formatting doc_comment_code_block_small_heuristics
    doc_comment_code_block_width edition emit_mode empty_item_single_line
    enum_discrim_align_threshold error_on_line_overflow error_on_unformatted
    float_literal_trailing_zero fn_call_width fn_params_layout fn_single_line
    force_explicit_abi force_multiline_blocks format_code_in_doc_comments
    format_generated_files format_macro_bodies format_macro_matchers
    format_strings generated_marker_line_search_limit group_imports hard_tabs
    hex_literal_case ignore imports_granularity imports_indent imports_layout
    indent_style inline_attribute_width make_backup match_arm_blocks
    match_arm_indent match_arm_leading_pipes match_block_trailing_comma
    max_width merge_derives newline_style normalize_comments
    normalize_doc_attributes overflow_delimited_expr remove_nested_parens
    reorder_impl_items reorder_imports reorder_modules required_version
    short_array_element_width_threshold show_parse_errors
    single_line_if_else_max_width single_line_let_else_max_width skip_children
    skip_macro_invocations space_after_colon space_before_colon
    spaces_around_ranges struct_field_align_threshold struct_lit_single_line
    struct_lit_width struct_variant_width style_edition tab_spaces
    trailing_comma trailing_semicolon type_punctuation_density
    unstable_features use_field_init_shorthand use_small_heuristics
    use_try_shorthand version where_single_line wrap_comments
    blank_lines_between_blocks generated_markers group_impls ignore_dirs
    impl_method_order import_grouping import_sort layout format
    layout_generated_files name_sort sort_alphabetically sort_imports
    test_module trait_impl_order trait_impl_sort type_order visibility_order
  )
  compset -P '*,'
  if compset -P '*='; then
    local key=${IPREFIX%=}
    _mto_setting_values ${key##*[,=]}
  else
    compadd -S '=' -a keys
  fi
}

# The values setting $1 takes, when they are a fixed set.
_mto_setting_values() {
  case $1 in
    (binop_separator) compadd -- Front Back ;;
    (brace_style) compadd -- AlwaysNextLine PreferSameLine SameLineWhere ;;
    (color) compadd -- Always Never Auto ;;
    (combine_control_expr|condense_wildcard_suffixes|disable_all_formatting|empty_item_single_line|error_on_line_overflow|error_on_unformatted|fn_single_line|force_explicit_abi|force_multiline_blocks|format_code_in_doc_comments|format_generated_files|format_macro_bodies|format_macro_matchers|format_strings|hard_tabs|make_backup|match_arm_blocks|match_arm_indent|match_block_trailing_comma|merge_derives|normalize_comments|normalize_doc_attributes|overflow_delimited_expr|remove_nested_parens|reorder_impl_items|reorder_imports|reorder_modules|show_parse_errors|skip_children|space_after_colon|space_before_colon|spaces_around_ranges|struct_lit_single_line|trailing_semicolon|unstable_features|use_field_init_shorthand|use_try_shorthand|where_single_line|wrap_comments|group_impls|import_grouping|layout|format|layout_generated_files|sort_alphabetically|sort_imports) compadd -- true false ;;
    (control_brace_style) compadd -- AlwaysSameLine ClosingNextLine AlwaysNextLine ;;
    (doc_comment_code_block_small_heuristics) compadd -- Inherit Off Max Default ;;
    (edition) compadd -- 2015 2018 2021 2024 ;;
    (emit_mode) compadd -- Files Stdout Coverage Checkstyle Json ModifiedLines Diff ;;
    (float_literal_trailing_zero) compadd -- Preserve Always IfNoPostfix Never ;;
    (fn_params_layout) compadd -- Compressed Tall Vertical ;;
    (group_imports) compadd -- Preserve StdExternalCrate One ;;
    (hex_literal_case) compadd -- Preserve Upper Lower ;;
    (imports_granularity) compadd -- Preserve Crate Module Item One ;;
    (imports_indent|indent_style) compadd -- Visual Block ;;
    (imports_layout) compadd -- Vertical Horizontal HorizontalVertical Mixed ;;
    (match_arm_leading_pipes) compadd -- Always Never Preserve ;;
    (newline_style) compadd -- Auto Windows Unix Native ;;
    (style_edition) compadd -- 2015 2018 2021 2024 2027 ;;
    (trailing_comma) compadd -- Always Never Vertical ;;
    (type_punctuation_density) compadd -- Compressed Wide ;;
    (use_small_heuristics) compadd -- Off Max Default ;;
    (version) compadd -- One Two ;;
    (impl_method_order) compadd -- written trait ;;
    (import_sort) compadd -- style_edition 2015 2024 ;;
    (name_sort) compadd -- version bytes case_insensitive ;;
    (test_module) compadd -- last in_place ;;
    (trait_impl_sort) compadd -- name original ;;
  esac
}

_mto_commands() {
  local -a commands
  commands=(
    'init:Write a default mto.toml'
    'config:Show the configuration that applies in a folder, or every setting'
    'history:List, show or prune the runs that wrote files'
    'restore:Undo a run'
    'doctor:Guard the build against mto'\''s edits, or find the edit that broke it'
    'report:The bug reports mto keeps when it finds a bug in itself'
    'debug:Print what mto sees in a file, or where and why it leaves code as written'
    'completions:Print or install the completions for a shell'
  )
  _describe -t commands command commands
}

_mto_init() {
  _arguments -s : \
    '(- *)'{-h,--help}'[Show this help and exit]' \
    '*: :_files -/'
}

_mto_config_subcommands() {
  local -a subcommands
  subcommands=(
    'path:List the configuration files that apply, and the history folder'
    'print:Show every setting in effect, with where it came from'
    'options:List every setting a configuration file may hold'
  )
  _describe -t subcommands subcommand subcommands
}

_mto_config() {
  local curcontext=$curcontext state state_descr line ret=1
  _arguments -C -s : \
    '(- *)'{-h,--help}'[Show this help and exit]' \
    '1: :->first' \
    '*:: :->rest' && ret=0
  case $state in
    (first)
      _mto_config_subcommands && ret=0
      ;;
    (rest)
      case $words[1] in
        (path)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--config=[Set settings for this run, over every file]:key=value,...:_mto_settings' \
            '--config-path=[Use only this configuration file; search for no other]:file:_files' \
            '--edition=[The Rust edition, over Cargo.toml and configuration files]:year:(2015 2018 2021 2024)' \
            '--style-edition=[The style edition, which decides the defaults]:year:(2015 2018 2021 2024 2027)' \
            '*: :_files -/' && ret=0
          ;;
        (print)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--current[Every setting in effect, with its source (the default)]' \
            '--default[Every setting at its default]' \
            '--minimal[Only the settings that differ from their defaults]' \
            '--user[The user config'\''s settings]' \
            '--config=[Set settings for this run, over every file]:key=value,...:_mto_settings' \
            '--config-path=[Use only this configuration file; search for no other]:file:_files' \
            '--edition=[The Rust edition, over Cargo.toml and configuration files]:year:(2015 2018 2021 2024)' \
            '--style-edition=[The style edition, which decides the defaults]:year:(2015 2018 2021 2024 2027)' \
            '*: :_files -/' && ret=0
          ;;
        (options)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--toml[As a commented file, every setting at its default]' \
            '*: : ' && ret=0
          ;;
      esac
      ;;
  esac
  return ret
}

_mto_history_subcommands() {
  local -a subcommands
  subcommands=(
    'show:List one run'\''s files and where each stands now'
    'prune:Remove old runs'
