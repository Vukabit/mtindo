_mto_history() {
  local curcontext=$curcontext state state_descr line ret=1
  _arguments -C -s : \
    '(- *)'{-h,--help}'[Show this help and exit]' \
    '--all[List every project'\''s runs]' \
    '1: :->first' \
    '*:: :->rest' && ret=0
  case $state in
    (first)
      _mto_history_subcommands && ret=0
      ;;
    (rest)
      case $words[1] in
        (show)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '*: : ' && ret=0
          ;;
        (prune)
          _arguments -s : \
            '(- *)'{-h,--help}'[Show this help and exit]' \
            '--keep=[Keep only the newest N runs]:n: ' \
            '--older-than=[Remove runs this old: 30 (days), 2w, 12h]:days: ' \
            '*: : ' && ret=0
          ;;
      esac
      ;;
  esac
  return ret
}

_mto_restore() {
