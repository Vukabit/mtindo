}

_mto() {
  local curcontext=$curcontext state state_descr line ret=1
  local -a top
  top=(
    '--check[Print a diff for every file that would change; exit 1 if any]'
    '(-d --dry-run)'{-d,--dry-run}'[List the files that would change, without writing]'
    '--emit=[Write the files (default), print them, or report changes as JSON]:value:(files stdout json)'
    '(-l --files-with-diff)'{-l,--files-with-diff}'[Name the files that change (or would, with --check) instead of showing how]'
    '--follow-links[Also follow symlinked files and directories]'
    '(-R --recursive)'{-R,--recursive}'[Format every .rs file under the current directory]'
    '--skip-children[A file argument is that file alone, not the modules it declares]'
    '--stdin-filepath=[With -: where the source belongs, for its settings and in messages]:path:_files'
    '--config=[Set settings for this run, over every file]:key=value,...:_mto_settings'
    '--config-path=[Use only this configuration file; search for no other]:file:_files'
    '--edition=[The Rust edition, over Cargo.toml and configuration files]:year:(2015 2018 2021 2024)'
    '--print-config=[Print the formatting settings as the standard formatter prints them, and exit]:value:(default minimal current)'
    '--style-edition=[The style edition, which decides the defaults]:year:(2015 2018 2021 2024 2027)'
    '--unstable-features[Accepted for compatibility; mto applies every setting on every channel]'
    '--allow-dirty[With history off, rewrite files that have uncommitted changes]'
    '--unguarded[Do not check this run with the build guard, nor hold back the edits it holds]'
    '--no-history[Do not record this run in history (it cannot be restored)]'
    '--color=[Color the output (default: auto, only on a terminal)]:value:(always never auto)'
    '--dbg[Print how each file was split into items]'
    '(-q --quiet)'{-q,--quiet}'[Print only errors and what was asked for]'
    '(-v --verbose)'{-v,--verbose}'[Name each file as it is formatted]'
    '(- *)'{-h,--help}'[Show this help and exit]'
    '--man[Print the full manual]'
    '(-V --version)'{-V,--version}'[Print the version and exit]'
  )
  _arguments -C -s : $top \
    '1: :->first' \
    '*:: :->rest' && ret=0
  case $state in
    (first)
      _alternative \
        'commands:command:_mto_commands' \
        'files:file:_files -g "*.rs(-.)"' && ret=0
      ;;
    (rest)
      case $words[1] in
        (init) _mto_init && ret=0 ;;
        (config) _mto_config && ret=0 ;;
        (history) _mto_history && ret=0 ;;
        (restore) _mto_restore && ret=0 ;;
        (doctor) _mto_doctor && ret=0 ;;
        (report) _mto_report && ret=0 ;;
        (debug) _mto_debug && ret=0 ;;
        (completions) _mto_completions && ret=0 ;;
        (*) _arguments -s : $top '*:file:_files -g "*.rs(-.)"' && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

if [ "$funcstack[1]" = "_mto" ]; then
  _mto "$@"
else
  compdef _mto mto
fi
