# mto VERSION completions for fish, generated by `mto completions fish`; do not edit.
# fish loads it from its completions folder.

# Prints the command and the subcommand given so far (- for none), then how many
# arguments followed them (-1 after `--`).
function __mto_state
    set -l takes_value --emit --stdin-filepath --config --config-path --edition \
        --print-config --style-edition --color --keep --dir --older-than
    set -l commands init config history restore doctor report debug completions
    set -l subcommands 'config path' 'config print' 'config options' 'history show' \
        'history prune' 'doctor on' 'doctor off' 'doctor holds' \
        'doctor release' 'report show' 'report save' 'report send' \
        'report prune' 'debug tokens' 'debug tree' 'debug layout' \
        'completions install' 'completions uninstall' 'completions status'
    set -l words (commandline -opc)
    set -e words[1]
    set -l command -
    set -l sub -
    set -l operands 0
    set -l expect 0
    for word in $words
        if test $expect = 1
            set expect 0
            continue
        end
        switch $word
            case '--'
                set operands -1
                break
            case '--*=*'
            case '-?*'
                if contains -- $word $takes_value
                    set expect 1
                end
            case '*'
                if test $operands = 0; and test $command = -; and contains -- $word $commands
                    set command $word
                else if test $operands = 0; and test $command != -; and test $sub = -; and contains -- "$command $word" $subcommands
                    set sub $word
                else
                    set operands (math $operands + 1)
                end
        end
    end
    printf '%s\n' $command $sub $operands
end

# Whether the command line is at command $1 and subcommand $2, and with a third
# argument, whether nothing followed them yet.
function __mto_at
    set -l state (__mto_state)
    test $state[1] = $argv[1]; and test $state[2] = $argv[2]; or return 1
    if set -q argv[3]
        test $state[3] = 0
    end
end

# --config's pairs: the settings, then after `=` the setting's values.
function __mto_settings
    set -l typed (string replace -r -- '^--config=' '' (commandline -ct))
    set -l head (string match -r -- '^.*,' $typed)
    set -l last (string replace -r -- '^.*,' '' $typed)
    if string match -q -- '*=*' $last
        set -l key (string replace -r -- '=.*' '' $last)
        for value in (__mto_setting_values $key)
            printf '%s%s=%s\n' "$head" $key $value
        end
    else
        for key in array_width attr_fn_like_width binop_separator \
            blank_lines_lower_bound blank_lines_upper_bound brace_style \
            chain_width color combine_control_expr comment_width \
            condense_wildcard_suffixes control_brace_style \
            disable_all_formatting doc_comment_code_block_small_heuristics \
            doc_comment_code_block_width edition emit_mode \
            empty_item_single_line enum_discrim_align_threshold \
            error_on_line_overflow error_on_unformatted \
            float_literal_trailing_zero fn_call_width fn_params_layout \
            fn_single_line force_explicit_abi force_multiline_blocks \
            format_code_in_doc_comments format_generated_files \
            format_macro_bodies format_macro_matchers format_strings \
            generated_marker_line_search_limit group_imports hard_tabs \
            hex_literal_case ignore imports_granularity imports_indent \
            imports_layout indent_style inline_attribute_width make_backup \
            match_arm_blocks match_arm_indent match_arm_leading_pipes \
            match_block_trailing_comma max_width merge_derives newline_style \
            normalize_comments normalize_doc_attributes \
            overflow_delimited_expr remove_nested_parens reorder_impl_items \
            reorder_imports reorder_modules required_version \
            short_array_element_width_threshold show_parse_errors \
            single_line_if_else_max_width single_line_let_else_max_width \
            skip_children skip_macro_invocations space_after_colon \
            space_before_colon spaces_around_ranges \
            struct_field_align_threshold struct_lit_single_line \
            struct_lit_width struct_variant_width style_edition tab_spaces \
            trailing_comma trailing_semicolon type_punctuation_density \
            unstable_features use_field_init_shorthand use_small_heuristics \
            use_try_shorthand version where_single_line wrap_comments \
            blank_lines_between_blocks generated_markers group_impls \
            ignore_dirs impl_method_order import_grouping import_sort layout \
            format layout_generated_files name_sort sort_alphabetically \
            sort_imports test_module trait_impl_order trait_impl_sort \
            type_order visibility_order
            printf '%s%s=\n' "$head" $key
        end
    end
end

# The values setting $1 takes, when they are a fixed set.
function __mto_setting_values
    switch $argv[1]
        case binop_separator
            printf '%s\n' Front Back
        case brace_style
            printf '%s\n' AlwaysNextLine PreferSameLine SameLineWhere
        case color
            printf '%s\n' Always Never Auto
        case combine_control_expr condense_wildcard_suffixes disable_all_formatting empty_item_single_line error_on_line_overflow error_on_unformatted fn_single_line force_explicit_abi force_multiline_blocks format_code_in_doc_comments format_generated_files format_macro_bodies format_macro_matchers format_strings hard_tabs make_backup match_arm_blocks match_arm_indent match_block_trailing_comma merge_derives normalize_comments normalize_doc_attributes overflow_delimited_expr remove_nested_parens reorder_impl_items reorder_imports reorder_modules show_parse_errors skip_children space_after_colon space_before_colon spaces_around_ranges struct_lit_single_line trailing_semicolon unstable_features use_field_init_shorthand use_try_shorthand where_single_line wrap_comments group_impls import_grouping layout format layout_generated_files sort_alphabetically sort_imports
            printf '%s\n' true false
        case control_brace_style
            printf '%s\n' AlwaysSameLine ClosingNextLine AlwaysNextLine
        case doc_comment_code_block_small_heuristics
            printf '%s\n' Inherit Off Max Default
        case edition
            printf '%s\n' 2015 2018 2021 2024
        case emit_mode
            printf '%s\n' Files Stdout Coverage Checkstyle Json ModifiedLines Diff
        case float_literal_trailing_zero
            printf '%s\n' Preserve Always IfNoPostfix Never
        case fn_params_layout
            printf '%s\n' Compressed Tall Vertical
        case group_imports
            printf '%s\n' Preserve StdExternalCrate One
        case hex_literal_case
            printf '%s\n' Preserve Upper Lower
        case imports_granularity
            printf '%s\n' Preserve Crate Module Item One
        case imports_indent indent_style
            printf '%s\n' Visual Block
        case imports_layout
            printf '%s\n' Vertical Horizontal HorizontalVertical Mixed
        case match_arm_leading_pipes
            printf '%s\n' Always Never Preserve
        case newline_style
            printf '%s\n' Auto Windows Unix Native
        case style_edition
            printf '%s\n' 2015 2018 2021 2024 2027
        case trailing_comma
            printf '%s\n' Always Never Vertical
        case type_punctuation_density
            printf '%s\n' Compressed Wide
        case use_small_heuristics
            printf '%s\n' Off Max Default
        case version
            printf '%s\n' One Two
        case impl_method_order
            printf '%s\n' written trait
        case import_sort
            printf '%s\n' style_edition 2015 2024
        case name_sort
            printf '%s\n' version bytes case_insensitive
        case test_module
            printf '%s\n' last in_place
        case trait_impl_sort
            printf '%s\n' name original
    end
end

